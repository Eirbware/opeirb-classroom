---
import BaseLayout from "../../layouts/base.astro"
import Card from "../partials/card.astro";
import { type BaseMarkdownProps } from "../../content.util";
type Props = BaseMarkdownProps<null> & { coursePaginatedBatch: BaseMarkdownProps<"courses">[] };

const props = Astro.props;
---

<BaseLayout {...props} >
<main class="prose dark:prose-invert container">
  <header class="text-center mb-8 mt-20 inset-0">
    <h1 class="text-5xl mb-1">{props.frontmatter.title}</h1>
    <p class="my-0 dark:text-gray3">{props.frontmatter.description}</p>
  </header>

  <div
    class="mx-auto w-24 h-1 my-12 bg-gradient-to-r from-gray5 to-gray4 rounded-full"
  ></div>

  <ul class="grid-list justify-items-center pl-0">
      { props.coursePaginatedBatch.map(course => (
        <li class="list-none p-0"><Card {...course}></Card></li>
      ))}
  </ul>

  {
    /* {{ template "_internal/pagination.html" . }} */
  }
</main>
</BaseLayout>
