---
import { getCollection } from "astro:content";
import { convertCollection, type BaseMarkdownProps } from "../../../content.util";
import type { GetStaticPathsOptions } from "astro";
import CourseListLayout from "../../../layouts/courses/list.astro";
import * as courseIndexProps from "../../../content/courses/index.md";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return paginate(
    convertCollection<"courses">(
      await getCollection("courses")
    ), { pageSize: 20 });
}

const { page } = Astro.props;
---

<CourseListLayout {...(courseIndexProps as unknown as BaseMarkdownProps<null>)} coursePaginatedBatch={page.data}></CourseListLayout>
