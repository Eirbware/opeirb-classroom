---
import LoginBtn from "../ui/buttons/LoginBtn.svelte";

import NavLink from "@components/ui/links/NavLink.astro";
import enStrings from "@utils/navigation.ts";
import frStrings from "@utils/fr/navigation.ts";

// Select the correct translation based on the page's lang prop:
const strings = Astro.currentLocale === "fr" ? frStrings : enStrings;
---
<div class="relative">
  <button
    id="menu-button"
    class="rounded px-4 py-2"
  >
    <!-- Home button -->
    <svg class="h-5 w-5 text-foreground bg-background" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" 
      viewBox="0 0 27.02 27.02" xml:space="preserve">
    <g>
      <path style="fill:currentColor;" d="M3.674,24.876c0,0-0.024,0.604,0.566,0.604c0.734,0,6.811-0.008,6.811-0.008l0.01-5.581
        c0,0-0.096-0.92,0.797-0.92h2.826c1.056,0,0.991,0.92,0.991,0.92l-0.012,5.563c0,0,5.762,0,6.667,0
        c0.749,0,0.715-0.752,0.715-0.752V14.413l-9.396-8.358l-9.975,8.358C3.674,14.413,3.674,24.876,3.674,24.876z"/>
      <path style="fill:currentColor;" d="M0,13.635c0,0,0.847,1.561,2.694,0l11.038-9.338l10.349,9.28c2.138,1.542,2.939,0,2.939,0
        L13.732,1.54L0,13.635z"/>
      <polygon style="fill:currentColor;" points="23.83,4.275 21.168,4.275 21.179,7.503 23.83,9.752 	"/>
    </g>
    </svg>
  </button>

  <ul
    id="menu"
    class="absolute mt-2 hidden w-48 rounded bg-white shadow-lg"
  >
    <!-- Navigation links and Authentication component -->
    {
    /* The components will not be hovered as it is on mobile */
    }
    {strings.navBarLinks.map(link => (
    <li class="block px-4 py-2">
      <NavLink url={link.url} name={link.name} />
    </li>
    ))}
    <li class="block px-4 py-2 border-t border-gray-200">
      <LoginBtn client:load />
    </li>
  </ul>
</div>

<script>
  const button = document.getElementById('menu-button');
  const menu = document.getElementById('menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>

<style>
  li {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-1);
  }

  a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }
</style>
