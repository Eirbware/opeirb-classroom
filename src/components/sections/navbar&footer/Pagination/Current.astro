---
export type Props = {
  pageNumber: number;
};

const { pageNumber } = Astro.props;
---

<span class="min-h-11.5 min-w-11.5 flex justify-center items-center bg-gray-200 text-gray-800 py-3 px-4 text-sm rounded-lg focus:outline-hidden focus:bg-gray-300 disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-600 dark:text-white dark:focus:bg-neutral-500" aria-current="page" arial-label={`Current page, page ${pageNumber}`}>{pageNumber}</span>
