---
// Import necessary components
import { Image } from "astro:assets";

import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const { blogEntry } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<"courses" | "tips">;
}
const authorData = await getEntry(blogEntry.data.mainAuthor);
---

<div class="shrink-0">
  <Image
    class="size-[46px] rounded-full border-2 border-neutral-50"
    src={authorData.data.authorImage}
    alt={authorData.data.authorImageAlt}
    draggable={"false"}
    format={"avif"}
  />
</div>
