---
import { parseHref } from '@/utils/filter_language';

// Destructure the properties from Astro.props
const { url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}
const { pathname } = Astro.url;
const isCurrent = parseHref(pathname).sectionId === parseHref(url).sectionId;

const notCurrentClasses = [
  "text-neutral-600",
  "dark:text-neutral-400",
  "hover:text-neutral-500",
  "dark:hover:text-neutral-500"
].join(" ");
const currentClasses = [
  "text-orange-400", "dark:text-orange-300"
].join(" ");

const colorClasses = isCurrent ? currentClasses : notCurrentClasses;
---

<!--
Re-usable link component for navigation bar. Highlights the active link
by comparing the current URL with the href of each link.
We assign an ID matching the URL for easy reference in our script.
If URL is '/' (home page), assign ID as 'home' 
-->
<a
  id={url === "/" ? "home" : url.replace("/", "")}
  href={url}
  data-astro-prefetch
  class=`rounded-lg text-base font-medium outline-hidden ring-zinc-500 focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden md:py-3 md:text-sm 2xl:text-base ${colorClasses}`
  aria-current={ isCurrent ? "page" : undefined }
>
  {name}
</a>
