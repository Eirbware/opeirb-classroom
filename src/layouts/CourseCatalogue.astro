---
// Import necessary components, modules and types
import StarlightScrewfastLayout from "./StarlightScrewfastLayout.astro";
import CardInsight from "@components/ui/cards/CardInsight.astro";
import Pagination from "@/components/sections/navbar&footer/Pagination/Pagination.astro";
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";

// Get all blogs post in the given language and sort
// them based on publish date

type Props = {
  posts: CollectionEntry<"courses">[] | CollectionEntry<"tips">[]
  page: Page<CollectionEntry<"courses">> | Page<CollectionEntry<"tips">>
}
const { posts, page } = Astro.props;
// Get all insights posts
const insightPosts = posts;

// Define variables for page content
const title: string = "Your Gateway to Construction Excellence";
const subTitle: string =
  "Explore the latest news, tips, and insights from ScrewFast to enhance your construction projects. From product spotlights to project management strategies, our blog is your go-to resource for all things hardware and construction.";
const secondTitle: string = "Insights";
const secondSubTitle: string =
  "Stay up-to-date with the latest trends and developments in the construction industry with insights from ScrewFast's team of industry experts. ";

// TODO: pass it as prop
const pageTitle: string = `Catalogue | Course`;
const metaDescription =
  "Stay up-to-date with the latest trends and developments in the construction industry with insights from ScrewFast's team of industry experts.";
---

<StarlightScrewfastLayout
  title={pageTitle}
  {metaDescription}
>
  <section
    class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    {/* Page header */}
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1
        class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200"
      >
        {title}
      </h1>

      <p
        class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400"
      >
        {subTitle}
      </p>
    </div>
  </section>

  {/* Post grid */}
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        insightPosts.map((insightEntry) => (
          <CardInsight insightEntry={insightEntry} />
        ))
      }
    </div>
  </section>

  {/* Pagination */}
  <Pagination page={page} urlPattern={
  page.url.current.split("/").slice(0, -1).join("/") + "/{}"
  } firstPageUrl={
    // Start to the page 1 in the catalogue
  page.url.current.split("/").slice(0, -1).join("/") + "/1"
    }/>

</StarlightScrewfastLayout>
