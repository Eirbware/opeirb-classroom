---
// Import necessary components, modules and types
import PrimaryCTA from "@/components/ui/buttons/PrimaryCTA.astro";
import StarlightScrewfastLayout from "./StarlightScrewfastLayout.astro";
import CardBlog from "@components/ui/cards/CardBlog.astro";
import CardBlogRecent from "@components/ui/cards/CardBlogRecent.astro";
import type { CollectionEntry } from "astro:content";
import path from "node:path";

// Get all blogs post in the given language and sort
// them based on publish date

type Props = {
  postType: "courses" | "tips",
  firstPosts: CollectionEntry<"courses">[] | CollectionEntry<"tips">[]
}
const { firstPosts: blogPosts, postType } = Astro.props;

// Separate the most recent post from others
const mostRecentPost: CollectionEntry<"courses" | "tips"> | null = blogPosts.length > 0 ? blogPosts[0] : null;
const otherPosts: CollectionEntry<"courses" | "tips">[] = blogPosts.slice(1);

// Define variables for page content
const title: string = Astro.locals.t(`title.index.${postType}`);
const subTitle: string = Astro.locals.t(`description.index.${postType}`);

const pageTitle: string = title;
const metaDescription = subTitle;
---

<StarlightScrewfastLayout title={pageTitle} metaDescription={metaDescription}>
  <section
    class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    {/* Page header */}
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1
        class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200"
      >
        {title}
      </h1>

      <p
        class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400"
      >
        {subTitle}
      </p>
    </div>
  </section>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    {/* Blog posts grid */}
    <div class="grid gap-6 lg:grid-cols-2">
      {otherPosts.map((blogEntry) => <CardBlog blogEntry={blogEntry} />)}
    </div>
  </section>
  {/* Most recent blog post */}
  { mostRecentPost && (
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <CardBlogRecent blogEntry={mostRecentPost} />
  </section>
  <section
    class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    {/* TODO: put a custom title in function of the props */}
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <PrimaryCTA url={path.join(Astro.url.pathname, "1")} title="See more Courses" />
    </div>
  </section>
  ) }
</StarlightScrewfastLayout>
