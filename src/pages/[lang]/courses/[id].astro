---
import { getCollection } from 'astro:content';
import { parseId } from "@/utils/filter_language";

import CourseLandingPage from '@/layouts/CourseLandingPage.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection("courses");
  return blogPosts.map((post) => {
    const { lang, postId } = parseId(post.id);
    return {
      params: { lang, id: postId },
      props: { post },
    };
  });
}
const { post } = Astro.props;
---

<CourseLandingPage {post} sectionName="courses" />
