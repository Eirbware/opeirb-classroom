---
import { getCollection } from 'astro:content';
import { parseId } from "@/utils/filter_language";

import CourseLandingPage from '@/layouts/CourseLandingPage.astro';

// Update getStaticPaths for English posts
export async function getStaticPaths() {
  const blogPosts = await getCollection("courses");
  return blogPosts.map((post) => {
    const { lang, firstSection } = parseId(post.id);
    return {
      params: { lang, id: firstSection },
      props: { post },
    };
  });
}
const { post } = Astro.props;
---

<CourseLandingPage {post}/>
