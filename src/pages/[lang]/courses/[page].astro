---
import type { GetStaticPathsOptions } from 'astro';
import CourseCatalogue from '@/layouts/CourseCatalogue.astro';
import { getPaginatedPostCollection } from '@/utils/indexing';
import { defaultLanguage, getSupportedLanguages } from '@/utils/ui';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const locales = getSupportedLanguages().filter((lang) => lang !== defaultLanguage);
  const perLangIndexPages = locales.map(async lang => (await getPaginatedPostCollection(
    "courses",
    paginate,
    lang
  )));
  const flatten: <T>(iter: T[][]) => T[] = (iter) => iter.reduce((acc, lst) => [...acc, ...lst]);
  const flattenIndexPages = flatten(await Promise.all(perLangIndexPages));
  return flattenIndexPages;
}

const { page } = Astro.props;
---
<CourseCatalogue posts={page.data} page={page} />
