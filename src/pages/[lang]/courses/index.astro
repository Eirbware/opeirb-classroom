---
import CourseIndex from "@/layouts/CourseIndex.astro";
import { getFirstPostsInCollection } from "@/utils/indexing";
import { getSupportedLanguages } from "@/utils/ui";

export async function getStaticPaths() {
  const locales = getSupportedLanguages();

  return locales.map(lang => ({
    params: { lang },
  }))
}
const firstCourses = await getFirstPostsInCollection("courses", Astro.params.lang);
---

<CourseIndex firstPosts={firstCourses}/>
