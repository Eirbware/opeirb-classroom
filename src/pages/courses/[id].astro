---
import { getCollection } from 'astro:content';
import { parseAstroCollectionPageId, filterPerLanguage } from "@/utils/filter_language";

import CourseLandingPage from '@/layouts/CourseLandingPage.astro';

export async function getStaticPaths() {
  const blogPosts = await getCollection("courses", filterPerLanguage());
  return blogPosts.map((post) => {
    const { postId } = parseAstroCollectionPageId(post.id);
    return {
      params: { id: postId },
      props: { post },
    };
  });
}
const { post } = Astro.props;
---

<CourseLandingPage {post} sectionName="courses" />
